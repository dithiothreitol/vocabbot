{
  "description": "VocabBot confirmation gate: the learner confirms, in the host's own permission prompt, each commit of a previewed change and each direct write into a learner's folder.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"",
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"",
            "timeout": 15,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
