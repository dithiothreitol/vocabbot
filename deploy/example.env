# Copy to deploy/.env and set the domain whose DNS record points at this machine.
VOCABBOT_DOMAIN=vocab.example.org
# The time zone of the learning day of every account.
VOCABBOT_TIMEZONE=Europe/Warsaw
# Set to 1 to let anyone open an account without an invitation.
VOCABBOT_OPEN_SIGNUP=
# Password recovery by e-mail; leave the host empty for no recovery by mail.
# SECURITY is starttls (port 587), ssl (port 465) or none.
VOCABBOT_SMTP_HOST=
VOCABBOT_SMTP_PORT=587
VOCABBOT_SMTP_USER=
VOCABBOT_SMTP_PASSWORD=
VOCABBOT_SMTP_FROM=
VOCABBOT_SMTP_SECURITY=starttls
